{
  "name": "knowhoard",
  "productName": "小怪兽知识库",
  "version": "0.1.1",
  "description": "本地优先的个人知识库问答客户端：本地 embedding + 本地重排 + 自定义 OpenAI 兼容 LLM，支持 Obsidian vault 连接器。",
  "private": true,
  "license": "MIT",
  "main": "main/index.js",
  "scripts": {
    "build:vendor": "node scripts/build-vendor.js",
    "prestart": "npm run build:vendor",
    "start": "electron .",
    "predist": "npm run build:vendor",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.33.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "color-name": "^1.1.4",
    "color-string": "^1.9.1",
    "dompurify": "^3.2.4",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.18.1",
    "mammoth": "^1.11.0",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^33.4.9",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.knowhoard.app",
    "productName": "小怪兽知识库",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
